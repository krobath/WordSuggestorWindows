<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.2.0-beta.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Settings.*.json" WithCulture="false" LogicalName="WordSuggestorWindows.App.Localization.%(Filename)%(Extension)" />
    <Content Include="Core\**\*;Packs\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\MacOSCommandIcons\paintbrush.png" />
    <Resource Include="Assets\MacOSCommandIcons\brain_head_profile.png" />
    <Resource Include="Assets\MacOSCommandIcons\text_quote.png" />
    <Resource Include="Assets\MacOSCommandIcons\arrow_clockwise_abc.png" />
  </ItemGroup>

</Project>
