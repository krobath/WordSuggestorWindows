<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <!-- Keep the existing script/output contract while using typed WinRT APIs. -->
    <OutputPath Condition="'$(UseArtifactsOutput)' != 'true'">bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.2.0-beta.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Account\WindowsHelloWorker.ps1" LogicalName="WordSuggestorWindows.HelloWorker" />
    <EmbeddedResource Include="Speech\WindowsSpeechWorker.ps1" LogicalName="WordSuggestorWindows.SpeechWorker" />
    <EmbeddedResource Include="Localization\Settings.*.json" WithCulture="false" LogicalName="WordSuggestorWindows.App.Localization.%(Filename)%(Extension)" />
    <Content Include="Core\**\*;Packs\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\MacOSCommandIcons\paintbrush.png" />
    <Resource Include="Assets\MacOSCommandIcons\brain_head_profile.png" />
    <Resource Include="Assets\MacOSCommandIcons\text_quote.png" />
    <Resource Include="Assets\MacOSCommandIcons\arrow_clockwise_abc.png" />
  </ItemGroup>

</Project>
