<Window x:Class="WordSuggestorWindows.App.LegacySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordSuggestor - Tidligere indstillinger"
        Width="760"
        Height="620"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="BorderBrush" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <TextBlock x:Name="SettingsSaveStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSaveStatus" AutomationProperties.LiveSetting="Polite" />
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Indstillinger gemmes lokalt i Windows-brugerprofilen." />
            <Button Grid.Column="1"
                    Width="96"
                    Margin="0,0,8,0"
                    Padding="12,7"
                    Content="Annuller"
                    Click="CancelButton_OnClick" />
            <Button Grid.Column="2"
                    Width="112"
                    Padding="12,7"
                    Content="Gem"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Indstillinger"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <TextBlock Text="Tilpas ordforslag, oplæsning og lokale data."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <TabControl>

            <TabItem Header="Generelt">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Sprog og placering" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Aktivt sprog"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="LanguageComboBox"
                                          Margin="0,4,0,12"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="LanguageCode" />
                                <TextBlock Text="Ordforslagsboksens placering"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="PlacementModeComboBox"
                                          Margin="0,4,0,0"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Oplæsning" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Oplæsningssprog"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="SpeechLanguageModeComboBox"
                                          Margin="0,4,0,12"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value" />
                                <CheckBox x:Name="UseSystemSpeechSettingsCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Brug systemets oplæsningsindstillinger"
                                          Checked="SpeechSettings_OnChanged"
                                          Unchecked="SpeechSettings_OnChanged" />
                                <TextBlock Text="Systemstemme for aktivt sprog"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="SystemVoiceComboBox"
                                          Margin="0,4,0,6"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value" />
                                <TextBlock x:Name="VoiceStatusTextBlock"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Oplæsningshastighed"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock x:Name="ReadingSpeedValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                                <Slider x:Name="ReadingSpeedSlider"
                                        Minimum="-2"
                                        Maximum="2"
                                        TickFrequency="0.25"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,0,12"
                                        ValueChanged="ReadingSpeedSlider_OnValueChanged" />
                                <TextBlock Text="Oplæsningsstrategi"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="ReadingStrategyComboBox"
                                          Margin="0,4,0,12"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value" />
                                <TextBlock Text="Markering under oplæsning"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="ReadingHighlightModeComboBox"
                                          Margin="0,4,0,12"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Padding="10,6"
                                            Margin="0,0,8,0"
                                            Content="Åbn taleindstillinger"
                                            Click="OpenSpeechSettingsButton_OnClick" />
                                    <Button Padding="10,6"
                                            Content="Åbn sprogindstillinger"
                                            Click="OpenLanguageSettingsButton_OnClick" />
                                </StackPanel>
                                <TextBlock Text="Import af ekstra neurale stemmer understøttes endnu ikke på Windows."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ordforslag">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Ordforslag" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox x:Name="GlobalSuggestionsCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Aktiver ordforslag" />
                                <CheckBox x:Name="DomainListsCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Aktiver fagordslister"
                                          IsEnabled="False" />
                                <TextBlock Text="Fagordslister er endnu ikke tilgængelige i denne Windows-beta."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tekstanalyse">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Tekstanalyse" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox x:Name="TextAnalyzerEnabledCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Aktiver tekstanalyse"
                                          IsEnabled="False" />
                                <CheckBox x:Name="TextAnalyzerColoringCheckBox" IsEnabled="False"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="POS-farvemarkering" />
                                <CheckBox x:Name="SemanticDiagnosticsCheckBox" IsEnabled="False"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Semantiske kontekstdiagnoser (beta)" />
                                <CheckBox x:Name="PunctuationDiagnosticsCheckBox" IsEnabled="False"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Tegnsætningsdiagnoser (beta)" />
                                <TextBlock Text="Tekstanalyse er endnu ikke tilgængelig i denne beta. Dine indstillinger bevares."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Fejlsporing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Fejlsporing" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox x:Name="ErrorTrackingEnabledCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Aktiver fejlsporing" />
                                <CheckBox x:Name="StoreSentenceExamplesCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Gem sætningseksempler lokalt"
                                          IsEnabled="False" />
                                <TextBlock Text="Fejlindsigter gemmes lokalt som typer og antal. Teksteksempler kræver dit udtrykkelige tilvalg."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Avanceret">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Debug og performance" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox x:Name="PerformanceInstrumentationCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Performance-instrumentering"
                                          IsEnabled="False" />
                                <CheckBox x:Name="AppDebugLoggingCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Debug logs: App"
                                          IsEnabled="False" />
                                <CheckBox x:Name="PlacementDebugLoggingCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Debug logs: Panel/caret"
                                          IsEnabled="False" />
                                <CheckBox x:Name="CoreDebugLoggingCheckBox"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="Debug logs: WordSuggestorCore"
                                          IsEnabled="False" />
                                <TextBlock Text="Udvidede diagnostikindstillinger er ikke tilgængelige i denne beta."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Version og opdateringer">
                <StackPanel Margin="14">
                    <TextBlock x:Name="VersionText" FontSize="16" Margin="0,0,0,12" AutomationProperties.AutomationId="AppVersion" />
                    <TextBlock Text="Windows kontrollerer automatisk for opdateringer, når betaen er installeret via App Installer. Opdateringer bevarer dine lokale indstillinger, brugerord og sprogpakker."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" />
                    <Button x:Name="CheckUpdatesButton" Content="Søg efter opdateringer" HorizontalAlignment="Left" Padding="12,8" Click="CheckUpdates_OnClick"
                            AutomationProperties.Name="Søg efter opdateringer" />
                    <TextBlock x:Name="UpdateStatusText" Margin="0,12,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UpdateStatus" />
                    <Button x:Name="OpenUpdateButton" Content="Åbn opdatering i Windows" HorizontalAlignment="Left" Padding="12,8" Click="OpenUpdate_OnClick" Visibility="Collapsed" />
                    <TextBlock Text="Ekstern indsættelse er i denne beta kvalificeret til Notepad. I andre programmer eller forhøjede vinduer kan du bruge WordSuggestors separate editor."
                               Style="{StaticResource MutedTextStyle}" Margin="0,18,0,0" />
                    <TextBlock Text="Genveje: Ctrl+1…0 vælger forslag. Ctrl+Venstre/Højre skifter side. Tab accepterer i editoren. Ctrl+Alt+T læser markeret tekst. Genvejene er faste i denne beta."
                               Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
