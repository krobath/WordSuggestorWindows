<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WordSuggestorWindows.App.LegacySettingsWindow" Title="{DynamicResource WS.Settings.Window.LegacyTitle}" Width="760" Height="620" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <TextBlock x:Name="SettingsSaveStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSaveStatus" AutomationProperties.LiveSetting="Polite"/>
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{DynamicResource WS.Settings.Legacy.LocalNote}"/>
            <Button Grid.Column="1" Width="96" Margin="0,0,8,0" Padding="12,7" Content="{DynamicResource WS.Settings.Cancel}" Click="CancelButton_OnClick"/>
            <Button Grid.Column="2" Width="112" Padding="12,7" Content="{DynamicResource WS.Settings.Save}" IsDefault="True" Click="SaveButton_OnClick"/>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource WS.Settings.Legacy.Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <TextBlock Text="{DynamicResource WS.Settings.Legacy.Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="{DynamicResource WS.Settings.Category.general}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.LanguageGroup}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.ActiveLanguage}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="LanguageComboBox" Margin="0,4,0,12" DisplayMemberPath="Label" SelectedValuePath="Value">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.Placement}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="PlacementModeComboBox" Margin="0,4,0,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Category.speech}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource WS.Settings.SpeechLanguage.Title}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="SpeechLanguageModeComboBox" Margin="0,4,0,12" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <CheckBox x:Name="UseSystemSpeechSettingsCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.SystemSpeech.Title}" Checked="SpeechSettings_OnChanged" Unchecked="SpeechSettings_OnChanged"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.Voice}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="SystemVoiceComboBox" Margin="0,4,0,6" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock x:Name="VoiceStatusTextBlock" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource WS.Settings.O03.Title}" Style="{StaticResource MutedTextStyle}"/>
                                    <TextBlock x:Name="ReadingSpeedValueText" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}"/>
                                </Grid>
                                <Slider x:Name="ReadingSpeedSlider" Minimum="50" Maximum="150" TickFrequency="5" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" Margin="0,0,0,12" ValueChanged="ReadingSpeedSlider_OnValueChanged"/>
                                <TextBlock Text="{DynamicResource WS.Settings.O04.Title}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="ReadingStrategyComboBox" Margin="0,4,0,12" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Text="{DynamicResource WS.Settings.O05.Title}" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox x:Name="ReadingHighlightModeComboBox" Margin="0,4,0,12" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Padding="10,6" Margin="0,0,8,0" Content="{DynamicResource WS.Settings.OpenSpeech}" Click="OpenSpeechSettingsButton_OnClick"/>
                                    <Button Padding="10,6" Content="{DynamicResource WS.Settings.OpenLanguage}" Click="OpenLanguageSettingsButton_OnClick"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.NeuralNote}" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource WS.Settings.Category.suggestions}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Category.suggestions}" Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="GlobalSuggestionsCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.F01.Title}"/>
                                <CheckBox x:Name="DomainListsCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.Legacy.EnableDomains}" IsEnabled="False"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.DomainsNote}" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource WS.Settings.Category.textAnalysis}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Category.textAnalysis}" Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="TextAnalyzerEnabledCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.T01.Title}" IsEnabled="False"/>
                                <CheckBox x:Name="TextAnalyzerColoringCheckBox" IsEnabled="False" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.T02.Title}"/>
                                <CheckBox x:Name="SemanticDiagnosticsCheckBox" IsEnabled="False" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.T03.Title}"/>
                                <CheckBox x:Name="PunctuationDiagnosticsCheckBox" IsEnabled="False" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.T04.Title}"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.AnalysisNote}" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource WS.Settings.Category.errorTracking}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.Category.errorTracking}" Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="ErrorTrackingEnabledCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.E01.Title}"/>
                                <CheckBox x:Name="StoreSentenceExamplesCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.E02.Title}" IsEnabled="False"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.ErrorNote}" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource WS.Settings.Category.advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS.Settings.DiagnosticsGroup}" Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="PerformanceInstrumentationCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.A01.Title}" IsEnabled="False"/>
                                <CheckBox x:Name="AppDebugLoggingCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.A02.Title}" IsEnabled="False"/>
                                <CheckBox x:Name="PlacementDebugLoggingCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.Legacy.PanelDebug}" IsEnabled="False"/>
                                <CheckBox x:Name="CoreDebugLoggingCheckBox" Style="{StaticResource SettingCheckBoxStyle}" Content="{DynamicResource WS.Settings.A05.Title}" IsEnabled="False"/>
                                <TextBlock Text="{DynamicResource WS.Settings.Legacy.DebugNote}" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource WS.Settings.Legacy.Updates}">
                <StackPanel Margin="14">
                    <TextBlock x:Name="VersionText" FontSize="16" Margin="0,0,0,12" AutomationProperties.AutomationId="AppVersion"/>
                    <TextBlock Text="{DynamicResource WS.Settings.Legacy.UpdateNote}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12"/>
                    <Button x:Name="CheckUpdatesButton" Content="{DynamicResource WS.Settings.CheckUpdates}" HorizontalAlignment="Left" Padding="12,8" Click="CheckUpdates_OnClick" AutomationProperties.Name="{DynamicResource WS.Settings.CheckUpdates}"/>
                    <TextBlock x:Name="UpdateStatusText" Margin="0,12,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UpdateStatus"/>
                    <Button x:Name="OpenUpdateButton" Content="{DynamicResource WS.Settings.OpenUpdate}" HorizontalAlignment="Left" Padding="12,8" Click="OpenUpdate_OnClick" Visibility="Collapsed"/>
                    <TextBlock Text="{DynamicResource WS.Settings.Legacy.ExternalNote}" Style="{StaticResource MutedTextStyle}" Margin="0,18,0,0"/>
                    <TextBlock Text="{DynamicResource WS.Settings.Legacy.ShortcutNote}" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
