<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WordSuggestorWindows.App.Controls" x:Class="WordSuggestorWindows.App.SettingsWindow" Title="{DynamicResource WS.Settings.Window.Title}" Width="1000" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" Icon="/WordSuggestorWindows.App;component/Assets/AppIcon.png" PreviewKeyDown="Settings_OnPreviewKeyDown" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="10,18">
            <ListBox x:Name="CategoryNavigation" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="Category_OnSelectionChanged" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="{DynamicResource WS.Settings.Categories}" AutomationProperties.AutomationId="SettingsCategories">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </ListBox.Resources>
                <ListBoxItem Tag="profile" AutomationProperties.Name="{DynamicResource WS.Settings.Category.profile}" AutomationProperties.AutomationId="SettingsCategory_profile">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource WS.Settings.Category.profile}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource WS.Settings.Account}" Margin="24,5,0,10" FontSize="12"/>
                        <Separator/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="general" AutomationProperties.Name="{DynamicResource WS.Settings.Category.general}" AutomationProperties.AutomationId="SettingsCategory_general">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.general}"/>
                </ListBoxItem>
                <ListBoxItem Tag="speech" AutomationProperties.Name="{DynamicResource WS.Settings.Category.speech}" AutomationProperties.AutomationId="SettingsCategory_speech">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.speech}"/>
                </ListBoxItem>
                <ListBoxItem Tag="suggestions" AutomationProperties.Name="{DynamicResource WS.Settings.Category.suggestions}" AutomationProperties.AutomationId="SettingsCategory_suggestions">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.suggestions}"/>
                </ListBoxItem>
                <ListBoxItem Tag="textAnalysis" AutomationProperties.Name="{DynamicResource WS.Settings.Category.textAnalysis}" AutomationProperties.AutomationId="SettingsCategory_textAnalysis">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.textAnalysis}"/>
                </ListBoxItem>
                <ListBoxItem Tag="learning" AutomationProperties.Name="{DynamicResource WS.Settings.Category.learning}" AutomationProperties.AutomationId="SettingsCategory_learning">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.learning}"/>
                </ListBoxItem>
                <ListBoxItem Tag="errorTracking" AutomationProperties.Name="{DynamicResource WS.Settings.Category.errorTracking}" AutomationProperties.AutomationId="SettingsCategory_errorTracking">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.errorTracking}"/>
                </ListBoxItem>
                <ListBoxItem Tag="advanced" AutomationProperties.Name="{DynamicResource WS.Settings.Category.advanced}" AutomationProperties.AutomationId="SettingsCategory_advanced">
                    <TextBlock Text="{DynamicResource WS.Settings.Category.advanced}"/>
                </ListBoxItem>
            </ListBox>
        </Border>
        <Grid Grid.Column="1" Margin="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="CategoryTitle" Text="{DynamicResource WS.Settings.Category.profile}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.AutomationId="SettingsCategoryTitle"/>
            <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,12,0">
                    <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.profile}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.P02.Title}" ControlId="P02" Description="{DynamicResource WS.Settings.P02.Help}">
                                    <TextBlock Text="{DynamicResource WS.Settings.Unavailable}" TextWrapping="Wrap"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.P07.Title}" ControlId="P07" Description="{DynamicResource WS.Settings.P07.Help}">
                                    <CheckBox IsEnabled="False" Content="{DynamicResource WS.Settings.NotAvailable}"/>
                                </ui:SettingsRow>
                                <TextBlock Style="{StaticResource SettingsNote}" Text="{DynamicResource WS.Settings.AccountNote}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.LanguageGroup}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G01.Title}" ControlId="G01" Description="{DynamicResource WS.Settings.G01.Help}">
                                    <ComboBox x:Name="InterfaceLanguageComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G02.Title}" ControlId="G02" Description="{DynamicResource WS.Settings.G02.Help}">
                                    <ComboBox x:Name="LanguageComboBox" DisplayMemberPath="Label" SelectedValuePath="Value">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{DynamicResource WS.Settings.PlacementGroup}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G03.Title}" ControlId="G03" Description="{DynamicResource WS.Settings.G03.Help}">
                                    <CheckBox x:Name="FollowCaretOptionCheckBox"/>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{DynamicResource WS.Settings.UpdatesGroup}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G04.Title}" ControlId="G04" Description="{DynamicResource WS.Settings.G04.Help}">
                                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" AutomationProperties.AutomationId="AppVersion"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G05.Title}" ControlId="G05" Description="{DynamicResource WS.Settings.G05.Help}">
                                    <TextBlock Text="{DynamicResource WS.Settings.WindowsOwned}" TextWrapping="Wrap"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.G06.Title}" ControlId="G06" Description="{DynamicResource WS.Settings.G06.Help}">
                                    <Button x:Name="CheckUpdatesButton" Content="{DynamicResource WS.Settings.CheckUpdates}" Click="CheckUpdates_OnClick" AutomationProperties.Name="{DynamicResource WS.Settings.CheckUpdates}" Padding="8,5"/>
                                </ui:SettingsRow>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsNote}" AutomationProperties.AutomationId="UpdateStatus" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="OpenUpdateButton" Content="{DynamicResource WS.Settings.OpenUpdate}" HorizontalAlignment="Right" Padding="8,5" Click="OpenUpdate_OnClick" Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="SpeechPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.speech}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.SpeechLanguage.Title}" Visibility="Collapsed" ControlId="SpeechLanguage" Description="{DynamicResource WS.Settings.SpeechLanguage.Help}">
                                    <ComboBox x:Name="SpeechLanguageModeComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.SystemSpeech.Title}" Visibility="Collapsed" ControlId="SystemSpeech" Description="{DynamicResource WS.Settings.SystemSpeech.Help}">
                                    <CheckBox x:Name="UseSystemSpeechSettingsCheckBox"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.O01.Title}" ControlId="O01" Description="{DynamicResource WS.Settings.O01.Help}">
                                    <ComboBox x:Name="SystemVoiceComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </ui:SettingsRow>
                                <TextBlock x:Name="VoiceStatusTextBlock" Style="{StaticResource SettingsNote}"/>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.O02.Title}" ControlId="O02" Description="{DynamicResource WS.Settings.O02.Help}">
                                    <StackPanel>
                                        <Button Content="{DynamicResource WS.Settings.OpenSpeech}" Click="OpenSpeechSettingsButton_OnClick" Padding="6,4"/>
                                        <Button Content="{DynamicResource WS.Settings.OpenLanguage}" Click="OpenLanguageSettingsButton_OnClick" Margin="0,6,0,0" Padding="6,4"/>
                                    </StackPanel>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.O03.Title}" ControlId="O03" Description="{DynamicResource WS.Settings.O03.Help}">
                                    <StackPanel>
                                        <TextBlock x:Name="ReadingSpeedValueText" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                                        <Slider x:Name="ReadingSpeedSlider" Minimum="50" Maximum="150" TickFrequency="5" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.O04.Title}" ControlId="O04" Description="{DynamicResource WS.Settings.O04.Help}">
                                    <ComboBox x:Name="ReadingStrategyComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.O05.Title}" ControlId="O05" Description="{DynamicResource WS.Settings.O05.Help}">
                                    <ComboBox x:Name="ReadingHighlightModeComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="SuggestionsPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.suggestions}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.F01.Title}" ControlId="F01" Description="{DynamicResource WS.Settings.F01.Help}">
                                    <CheckBox x:Name="GlobalSuggestionsCheckBox"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.F17.Title}" ControlId="F17" Description="{DynamicResource WS.Settings.F17.Help}">
                                    <CheckBox x:Name="DomainListsCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <TextBlock Style="{StaticResource SettingsNote}" Text="{DynamicResource WS.Settings.SuggestionsNote}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="AnalysisPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.textAnalysis}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.T01.Title}" ControlId="T01" Description="{DynamicResource WS.Settings.T01.Help}">
                                    <CheckBox x:Name="TextAnalyzerEnabledCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.T02.Title}" ControlId="T02" Description="{DynamicResource WS.Settings.T02.Help}">
                                    <CheckBox x:Name="TextAnalyzerColoringCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.T03.Title}" ControlId="T03" Description="{DynamicResource WS.Settings.T03.Help}">
                                    <CheckBox x:Name="SemanticDiagnosticsCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.T04.Title}" ControlId="T04" Description="{DynamicResource WS.Settings.T04.Help}">
                                    <CheckBox x:Name="PunctuationDiagnosticsCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <TextBlock Style="{StaticResource SettingsNote}" Text="{DynamicResource WS.Settings.AnalysisNote}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="LearningPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.learning}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.L03.Title}" ControlId="L03" Description="{DynamicResource WS.Settings.L03.Help}">
                                    <TextBlock Text="{DynamicResource WS.Settings.Unavailable}" TextWrapping="Wrap"/>
                                </ui:SettingsRow>
                                <TextBlock Style="{StaticResource SettingsNote}" Text="{DynamicResource WS.Settings.LearningNote}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="ErrorsPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.Category.errorTracking}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.E01.Title}" ControlId="E01" Description="{DynamicResource WS.Settings.E01.Help}">
                                    <CheckBox x:Name="ErrorTrackingEnabledCheckBox"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.E02.Title}" ControlId="E02" Description="{DynamicResource WS.Settings.E02.Help}">
                                    <CheckBox x:Name="StoreSentenceExamplesCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
                        <GroupBox Header="{DynamicResource WS.Settings.DiagnosticsGroup}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.A01.Title}" ControlId="A01" Description="{DynamicResource WS.Settings.A01.Help}">
                                    <CheckBox x:Name="PerformanceInstrumentationCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.A02.Title}" ControlId="A02" Description="{DynamicResource WS.Settings.A02.Help}">
                                    <CheckBox x:Name="AppDebugLoggingCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.A03.Title}" ControlId="A03" Description="{DynamicResource WS.Settings.A03.Help}">
                                    <CheckBox x:Name="PlacementDebugLoggingCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.A05.Title}" ControlId="A05" Description="{DynamicResource WS.Settings.A05.Help}">
                                    <CheckBox x:Name="CoreDebugLoggingCheckBox" IsEnabled="False"/>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{DynamicResource WS.Settings.MigrationGroup}" Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ui:SettingsRow Header="{DynamicResource WS.Settings.A08.Title}" ControlId="A08" Description="{DynamicResource WS.Settings.A08.Help}">
                                    <Button Content="{DynamicResource WS.Settings.OpenLegacy}" Click="OpenLegacy_OnClick" Padding="8,5" AutomationProperties.AutomationId="SettingsLegacyOpen"/>
                                </ui:SettingsRow>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="SettingsSaveStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,4" AutomationProperties.AutomationId="SettingsSaveStatus" AutomationProperties.LiveSetting="Polite"/>
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource WS.Settings.Close}" Padding="20,6" Click="CloseButton_OnClick" AutomationProperties.AutomationId="SettingsClose"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource WS.Settings.AutoSaveNote}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
