<Window x:Class="WordSuggestorWindows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:WordSuggestorWindows.App.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WordSuggestor Windows"
        Width="560"
        Height="68"
        MinWidth="560"
        MinHeight="68"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True"
        WindowStyle="None"
        Icon="/WordSuggestorWindows.App;component/Assets/AppIcon.png">

    <Window.ContextMenu><ContextMenu>
        <MenuItem Header="Åbn editor" Click="ExpandCollapseButton_OnClick" />
        <MenuItem Header="Indstillinger" Tag="settings" Click="ToolbarAction_OnClick" />
        <Separator />
        <MenuItem Header="Afslut WordSuggestor" Click="Exit_OnClick" />
    </ContextMenu></Window.ContextMenu>
    <Grid Background="Transparent">
        <Border Margin="8"
                CornerRadius="16"
                Background="#F3F4F6"
                BorderBrush="#D3D7DE"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ToolbarSurface"
                        Padding="10,9"
                        Background="Transparent"
                        MouseLeftButtonDown="ToolbarSurface_OnMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    CornerRadius="5"
                                    Background="White"
                                    BorderBrush="#CCD2DA"
                                    BorderThickness="0.6">
                                <Image Source="/WordSuggestorWindows.App;component/Assets/AppIcon.png"
                                       Stretch="Uniform" />
                            </Border>

                            <ToggleButton Margin="0,0,10,0"
                                          IsChecked="{Binding IsGlobalCaptureEnabled, Mode=TwoWay}"
                                          Style="{StaticResource SwitchToggleButtonStyle}"
                                          AutomationProperties.Name="Aktiver eller deaktiver globale forslag" ToolTip="Aktiver eller deaktiver globale forslag" />

                            <ComboBox Width="58"
                                      Margin="0,0,12,0"
                                      ItemsSource="{Binding LanguageOptions}"
                                      ItemTemplate="{StaticResource LanguageFlagTemplate}"
                                      ItemContainerStyle="{StaticResource ToolbarComboBoxItemStyle}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                      Style="{StaticResource ToolbarComboBoxStyle}"
                                      ToolTip="{Binding SelectedLanguageOption.DisplayLabel}" />

                            <Button Tag="wordList"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="Fagordslister" ToolTip="Fagordslister"
                                    Click="ToolbarAction_OnClick">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#39424E" Text="&#xE8D2;" />
                            </Button>

                            <Button Tag="import"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="Importer markeret tekst til editoren" ToolTip="Importer markeret tekst til editoren"
                                    Click="ToolbarAction_OnClick">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="Importer via udklipsholder" Tag="importClipboard" Click="ToolbarAction_OnClick" />
                                </ContextMenu></Button.ContextMenu>
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#39424E" Text="&#xE8C8;" />
                            </Button>

                            <Button Tag="ocr"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="OCR / skærmudsnit" ToolTip="OCR / skærmudsnit"
                                    Click="ToolbarAction_OnClick">
                                <Grid Width="16" Height="14">
                                    <Rectangle RadiusX="2"
                                               RadiusY="2"
                                               Stroke="#39424E"
                                               StrokeThickness="1.1"
                                               StrokeDashArray="2,1" />
                                    <Rectangle Width="8"
                                               Height="1.2"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Fill="#39424E" />
                                    <Rectangle Width="6"
                                               Height="1.2"
                                               Margin="0,0,0,4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Fill="#39424E" />
                                </Grid>
                            </Button>

                            <Button Tag="speechToText"
                                    Background="{Binding SpeechToTextButtonBackground}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="{Binding SpeechToTextToolTip}" ToolTip="{Binding SpeechToTextToolTip}"
                                    Click="ToolbarAction_OnClick">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#39424E" Text="&#xE720;" />
                            </Button>

                            <Button Tag="textToSpeech"
                                    Background="{Binding TextToSpeechButtonBackground}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="{Binding TextToSpeechToolTip}" ToolTip="{Binding TextToSpeechToolTip}"
                                    Click="ToolbarAction_OnClick">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#39424E" Text="&#xE767;" />
                            </Button>

                            <Button Tag="insights"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="Fejlindsigter" ToolTip="Fejlindsigter"
                                    Click="ToolbarAction_OnClick">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#39424E" Text="&#xE9D2;" />
                            </Button>

                            <Button Tag="settings"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    AutomationProperties.Name="Indstillinger" ToolTip="Indstillinger"
                                    Click="ToolbarAction_OnClick">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#39424E" Text="&#xE713;" />
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="34"
                                Height="28"
                                Margin="12,0,0,0"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="{Binding ExpandCollapseToolTip}"
                                AutomationProperties.AutomationId="OpenEditor" AutomationProperties.Name="Åbn editor" Click="ExpandCollapseButton_OnClick">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="15"
                                       Text="{Binding ExpandCollapseGlyph}" />
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
