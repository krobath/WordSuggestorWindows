<UserControl x:Class="WordSuggestorWindows.App.Controls.AccountSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WordSuggestorWindows.App.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/WordSuggestorWindows.App;component/SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<StackPanel><TextBlock x:Name="Identity" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="AccountIdentity"/>
<TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.AutomationId="AccountStatus" AutomationProperties.LiveSetting="Polite"/>
<StackPanel Orientation="Horizontal"><Button x:Name="ReloadAccount" Content="{DynamicResource WS.Settings.AccountReload}" Margin="0,0,8,8"/><Button x:Name="UnlockAccount" Content="{DynamicResource WS.Settings.AccountUnlock}" Margin="0,0,0,8"/></StackPanel>
<StackPanel x:Name="Fields"><GroupBox x:Name="Anonymous" Header="{DynamicResource WS.Settings.P01.Title}" Style="{StaticResource SettingsGroup}"><StackPanel><ui:SettingsRow Header="{DynamicResource WS.Settings.P02.Title}" Description="{DynamicResource WS.Settings.P02.Help}" ControlId="P02"><ComboBox x:Name="AccessMode" DisplayMemberPath="Label" SelectedValuePath="Value"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P03.Title}" Description="{DynamicResource WS.Settings.P03.Help}" ControlId="P03"><StackPanel><TextBox x:Name="LoginEmail" AutomationProperties.Name="E-mail"/><PasswordBox x:Name="LoginPassword" AutomationProperties.Name="{DynamicResource WS.Settings.AccountPassword}" Margin="0,6,0,0"/></StackPanel></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P04.Title}" Description="{DynamicResource WS.Settings.P04.Help}" x:Name="RegistrationConfirmationRow" ControlId="P04"><PasswordBox x:Name="LoginConfirm"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P05.Title}" Description="{DynamicResource WS.Settings.P05.Help}" ControlId="P05"><Button x:Name="LoginButton" Content="{DynamicResource WS.Settings.AccountLogin}"/></ui:SettingsRow></StackPanel></GroupBox><ui:SettingsRow Header="{DynamicResource WS.Settings.P06.Title}" Description="{DynamicResource WS.Settings.P06.Help}" x:Name="VerificationRow" ControlId="P06"><Button x:Name="ResendButton" Content="{DynamicResource WS.Settings.AccountResend}"/></ui:SettingsRow>
<StackPanel x:Name="Authenticated"><GroupBox Header="{DynamicResource WS.Settings.AccountSecurity}" Style="{StaticResource SettingsGroup}"><StackPanel><ui:SettingsRow Header="{DynamicResource WS.Settings.P07.Title}" Description="{DynamicResource WS.Settings.P07.Help}" ControlId="P07"><CheckBox x:Name="HelloCheck"/></ui:SettingsRow><TextBlock Text="{DynamicResource WS.Settings.AccountHelloNote}" Style="{StaticResource SettingsNote}"/></StackPanel></GroupBox>
<GroupBox x:Name="PersonalFields" Header="{DynamicResource WS.Settings.AccountDetails}" Style="{StaticResource SettingsGroup}"><StackPanel><ui:SettingsRow Header="{DynamicResource WS.Settings.P08.Title}" Description="{DynamicResource WS.Settings.P08.Help}" ControlId="P08"><TextBox x:Name="ProfileName"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P09.Title}" Description="{DynamicResource WS.Settings.P09.Help}" ControlId="P09"><ComboBox x:Name="Age" DisplayMemberPath="Label" SelectedValuePath="Value"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P10.Title}" Description="{DynamicResource WS.Settings.P10.Help}" ControlId="P10"><ComboBox x:Name="Profession" DisplayMemberPath="Label" SelectedValuePath="Value"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P11.Title}" Description="{DynamicResource WS.Settings.P11.Help}" ControlId="P11"><ComboBox x:Name="Industry" DisplayMemberPath="Label" SelectedValuePath="Value"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P12.Title}" Description="{DynamicResource WS.Settings.P12.Help}" ControlId="P12"><CheckBox x:Name="Personalization"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P13.Title}" Description="{DynamicResource WS.Settings.P13.Help}" ControlId="P13"><Button x:Name="SaveProfile" Content="{DynamicResource WS.Settings.AccountSave}"/></ui:SettingsRow></StackPanel></GroupBox>
<GroupBox Header="{DynamicResource WS.Settings.AccountSecurity}" Style="{StaticResource SettingsGroup}"><StackPanel><ui:SettingsRow Header="{DynamicResource WS.Settings.P14.Title}" Description="{DynamicResource WS.Settings.P14.Help}" ControlId="P14"><TextBlock x:Name="VerifiedEmail"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P15.Title}" Description="{DynamicResource WS.Settings.P15.Help}" x:Name="EmailChangeRow" ControlId="P15"><StackPanel><TextBox x:Name="NewEmail" AutomationProperties.Name="{DynamicResource WS.Settings.AccountNewEmail}" Margin="0,4"/><TextBox x:Name="ConfirmEmail" AutomationProperties.Name="{DynamicResource WS.Settings.AccountConfirmEmail}" Margin="0,4"/><PasswordBox x:Name="EmailPassword" AutomationProperties.Name="{DynamicResource WS.Settings.AccountCurrentPassword}"/><Button x:Name="ChangeEmail" Content="{DynamicResource WS.Settings.P15.Title}" Margin="0,6"/><Button x:Name="CancelEmail" Content="{DynamicResource WS.Settings.AccountCancelEmail}"/></StackPanel></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P16.Title}" Description="{DynamicResource WS.Settings.P16.Help}" ControlId="P16"><StackPanel><PasswordBox x:Name="CurrentPassword" AutomationProperties.Name="{DynamicResource WS.Settings.AccountCurrentPassword}" Margin="0,4"/><PasswordBox x:Name="NewPassword" AutomationProperties.Name="{DynamicResource WS.Settings.AccountNewPassword}" Margin="0,4"/><PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="{DynamicResource WS.Settings.AccountConfirmPassword}" Margin="0,4"/><TextBlock Style="{StaticResource SettingsNote}" Text="{DynamicResource WS.Settings.P16.Help}"/></StackPanel></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P17.Title}" Description="{DynamicResource WS.Settings.P17.Help}" ControlId="P17"><Button x:Name="ChangePassword" Content="{DynamicResource WS.Settings.P17.Title}"/></ui:SettingsRow></StackPanel></GroupBox><ui:SettingsRow Header="{DynamicResource WS.Settings.P18.Title}" Description="{DynamicResource WS.Settings.P18.Help}" ControlId="P18"><TextBlock x:Name="Subscription"/></ui:SettingsRow><ui:SettingsRow Header="{DynamicResource WS.Settings.P20.Title}" Description="{DynamicResource WS.Settings.P20.Help}" ControlId="P20"><Button x:Name="LogoutAll" Content="{DynamicResource WS.Settings.P20.Title}"/></ui:SettingsRow></StackPanel><ui:SettingsRow Header="{DynamicResource WS.Settings.P19.Title}" Description="{DynamicResource WS.Settings.P19.Help}" ControlId="P19"><Button x:Name="LogoutCurrent" Content="{DynamicResource WS.Settings.P19.Title}"/></ui:SettingsRow></StackPanel></StackPanel></UserControl>