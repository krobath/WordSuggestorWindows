<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:WordSuggestorWindows.App.Controls">
 <Style x:Key="SettingsGroup" TargetType="GroupBox">
  <Setter Property="Margin" Value="0,0,0,20"/><Setter Property="Padding" Value="12"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="SettingsNote" TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,4"/>
  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
 </Style>
 <Style TargetType="controls:SettingsRow">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="controls:SettingsRow">
     <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PART_Label" Text="{TemplateBinding Header}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button x:Name="PART_Help" Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0" Padding="0" ToolTip="{TemplateBinding Description}">
         <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14"/>
        </Button>
       </Grid>
       <ContentPresenter Grid.Column="2" ContentSource="Content" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="340"/>
      </Grid>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
